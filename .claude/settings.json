{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git grep *)",
      "Bash(find *)",
      "Bash(ls *)",
      "Bash(python -m py_compile *)",
      "Bash(ruff check *)",
      "Bash(mypy *)",
      "Bash(pytest *)",
      "Bash(python -m pytest *)",
      "Bash(docker compose * config)",
      "Bash(docker compose * ps)",
      "Bash(docker compose * logs *)",
      "Bash(command -v docker)",
      "Bash(docker compose *)",
      "Bash(echo \"dev=$?\")",
      "Bash(echo \"prodlike=$?\")",
      "Bash(echo \"p5=$?\")",
      "Bash(echo \"whale-l5=$?\")",
      "Bash(python -c \"from tests.support import ingest_prodlike_runtime as m; print\\(m.COMPOSE_FILE\\)\")",
      "Bash(PYTHONPATH=src python -c \"from tests.support import ingest_prodlike_runtime as m; print\\(m.COMPOSE_FILE\\)\")",
      "Bash(echo \"EXIT=$?\")",
      "Bash(PYTHONPATH=src python3 -c \"from tests.support import ingest_prodlike_runtime as m; print\\(m.COMPOSE_FILE\\)\")",
      "Bash(python3 -c ' *)",
      "Bash(codex --version)",
      "Bash(python -c \"from whale.shared.persistence.template import PROTOCOL_SAMPLE_SPECS, generate_all_sample_data, reset_sample_data\")",
      "Bash(python -c \"from seahorse.infrastructure.repositories import WhaleMetadataRepository, WhaleMetadataToWritePlanMapper, WhaleMetadataMappingError\")",
      "Bash(python -c \"from whale.ingest.framework.persistence.init_db import load_default_sample_data\")",
      "Bash(python -c ' *)",
      "Bash(WHALE_DB_URL='sqlite:////tmp/tools_smoke.db' python -c \"from tools.sqlalchemy_session import engine, session_scope, get_session, SessionLocal, DB_URL_ENV; assert DB_URL_ENV == 'WHALE_DB_URL'; print\\('url =', engine.url\\)\")",
      "Bash(unset WHALE_DB_URL)",
      "Bash(python -c \"import tools.sqlalchemy_session\")",
      "Bash(python -c \"import whale.shared.persistence.session\")"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Read(./**/*id_rsa*)",
      "Read(./**/*private_key*)",
      "Bash(rm -rf *)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)",
      "Bash(git push *)",
      "Bash(sudo *)",
      "Bash(chmod -R 777 *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PROJECT_DIR}/ai_shared/agent_config/hooks/block-dangerous-bash.py"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/ai_shared/agent_config/hooks/no-source-lab-import-gate.sh"
          },
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PROJECT_DIR}/ai_shared/agent_config/hooks/docstring-cn-gate.py"
          }
        ]
      }
    ]
  }
}
