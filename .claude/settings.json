{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Read(./**/*id_rsa*)",
      "Read(./**/*private_key*)",
      "Bash(rm -rf *)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)",
      "Bash(git push *)",
      "Bash(sudo *)",
      "Bash(chmod -R 777 *)"
    ],
    "allow": [
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git grep *)",
      "Bash(find *)",
      "Bash(ls *)",
      "Bash(python -m py_compile *)",
      "Bash(ruff check *)",
      "Bash(mypy *)",
      "Bash(pytest *)",
      "Bash(python -m pytest *)",
      "Bash(docker compose * config)",
      "Bash(docker compose * ps)",
      "Bash(docker compose * logs *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PROJECT_DIR}/ai_shared/agent_config/hooks/block-dangerous-bash.py"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/ai_shared/agent_config/hooks/no-source-lab-import-gate.sh"
          },
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PROJECT_DIR}/ai_shared/agent_config/hooks/docstring-cn-gate.py"
          }
        ]
      }
    ]
  }
}