{
    "python-envs.defaultEnvManager": "ms-python.python:conda",
    "python-envs.defaultPackageManager": "ms-python.python:conda",
    "python.defaultInterpreterPath": "/home/luosh/miniconda3/envs/BlueCrystal/bin/python",
    "python.terminal.activateEnvironment": true,
    "python.terminal.activateEnvInCurrentTerminal": true,
    "terminal.integrated.defaultProfile.linux": "BlueCrystal Conda",
    "terminal.integrated.profiles.linux": {
        "BlueCrystal Conda": {
            "path": "/bin/bash",
            "args": [
                "-lc",
                "source /home/luosh/miniconda3/etc/profile.d/conda.sh && conda activate BlueCrystal && exec bash"
            ],
            "icon": "terminal-bash"
        },
        "bash": {
            "path": "/bin/bash",
            "icon": "terminal-bash"
        }
    }
}