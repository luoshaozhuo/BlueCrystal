{
  "name": "arco-design-pro-vue",
  "description": "Arco Design Pro for Vue",
  "version": "1.0.0",
  "private": true,
  "author": "ArcoDesign Team",
  "license": "MIT",
  "scripts": {
    "dev": "vite --config ./config/vite.config.dev.ts",
    "build": "vue-tsc --noEmit && vite build --config ./config/vite.config.prod.ts",
    "api:generate": "rm -rf ./src/api/generated/openapi && openapi-ts --input ./docs/openapi/showtime.openapi.yaml --output ./src/api/generated/openapi --client @hey-api/client-axios",
    "report": "cross-env REPORT=true npm run build",
    "preview": "npm run build && vite preview --host",
    "type:check": "vue-tsc --noEmit --skipLibCheck",
    "lint-staged": "npx lint-staged",
    "prepare": "husky install"
  },
  "lint-staged": {
    "*.{js,ts,jsx,tsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.vue": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{less,css}": [
      "stylelint --fix",
      "prettier --write"
    ]
  },
  "dependencies": {
    "@arco-design/web-vue": "^2.57.0",
    "@arco-themes/vue-techblue": "^0.0.2",
    "@vueuse/core": "^9.3.0",
    "axios": "^1.13.6",
    "cesium": "1.139.1",
    "codex": "^0.2.3",
    "echarts": "^6.0.0",
    "echarts-gl": "^2.0.9",
    "lodash": "^4.17.23",
    "mitt": "^3.0.0",
    "nprogress": "^0.2.0",
    "pinia": "^2.0.23",
    "vue": "^3.5.29",
    "vue-echarts": "^8.0.1",
    "vue-i18n": "^9.2.2",
    "vue-router": "^4.0.14"
  },
  "devDependencies": {
    "@arco-plugins/vite-vue": "^1.4.6",
    "@commitlint/cli": "^17.1.2",
    "@commitlint/config-conventional": "^17.1.0",
    "@eslint/js": "10.0.1",
    "@hey-api/client-axios": "0.9.1",
    "@hey-api/openapi-ts": "0.94.0",
    "@types/lodash": "^4.17.24",
    "@types/mockjs": "^1.0.7",
    "@types/nprogress": "^0.2.0",
    "@typescript-eslint/eslint-plugin": "^8.56.1",
    "@typescript-eslint/parser": "^8.56.1",
    "@vitejs/plugin-vue": "^6.0.4",
    "@vitejs/plugin-vue-jsx": "^5.1.4",
    "@vue/babel-plugin-jsx": "^2.0.1",
    "consola": "^2.15.3",
    "cross-env": "^7.0.3",
    "eslint": "^10.0.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-vue": "^10.8.0",
    "globals": "17.4.0",
    "husky": "^8.0.1",
    "less": "^4.5.1",
    "lint-staged": "^13.0.3",
    "mockjs": "^1.1.0",
    "postcss-html": "^1.8.1",
    "prettier": "^3.8.1",
    "rollup": "^4.59.0",
    "rollup-plugin-visualizer": "^5.8.2",
    "stylelint": "^17.4.0",
    "stylelint-config-rational-order": "^0.1.2",
    "stylelint-config-recommended-vue": "^1.6.1",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-order": "^7.0.1",
    "swagger-cli": "^4.0.4",
    "typescript": "^5.9.3",
    "unplugin-vue-components": "^31.0.0",
    "vite": "^7.3.1",
    "vite-plugin-compression": "^0.5.1",
    "vite-plugin-eslint": "^1.8.1",
    "vite-plugin-imagemin": "^0.6.1",
    "vite-plugin-static-copy": "^3.2.0",
    "vite-svg-loader": "^5.1.1",
    "vue-eslint-parser": "10.4.0",
    "vue-tsc": "^3.2.5"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "resolutions": {
    "bin-wrapper": "npm:bin-wrapper-china",
    "gifsicle": "5.2.0"
  }
}
