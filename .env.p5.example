# .env.p5.example
#
# Whale P5 准生产依赖验证期 — 环境变量示例文件。
# 复制为 .env.p5 后按需修改，不使用真实密钥的默认值即可运行 docker-compose.p5.yml。
#
# 使用方式：
#   cp .env.p5.example .env.p5
#   # 按需编辑 .env.p5
#   docker compose -f docker-compose.p5.yml --env-file .env.p5 up -d

# ---- PostgreSQL ----
# 集成测试使用 WHALE_TEST_POSTGRES_DSN
WHALE_TEST_POSTGRES_DSN=postgresql://whale:whale@localhost:5432/whale_test

# ---- TDengine ----
# WHALE_TDENGINE_DSN: taosAdapter 主机:端口（REST API 通信）
WHALE_TDENGINE_DSN=localhost:6041
# WHALE_TDENGINE_REST_PATH: REST API 路径（默认 /rest/sql）
WHALE_TDENGINE_REST_PATH=/rest/sql
# WHALE_TDENGINE_USER: TDengine 用户名
WHALE_TDENGINE_USER=root
# WHALE_TDENGINE_PASSWORD: TDengine 密码
WHALE_TDENGINE_PASSWORD=taosdata
# TAOS_DSN: 备选 DSN（优先级低于 WHALE_TDENGINE_DSN）
# TAOS_DSN=localhost:6041

# ---- Redis ----
WHALE_REDIS_URL=localhost:16379

# ---- Kafka (Redpanda) ----
WHALE_KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ---- S3 / MinIO ----
# WHALE_S3_ENDPOINT_URL: 完整 URL（含 http://）
WHALE_S3_ENDPOINT_URL=http://localhost:9000
# WHALE_S3_ENDPOINT: 仅 host:port（用于 TCP 探测）
WHALE_S3_ENDPOINT=localhost:9000
WHALE_S3_BUCKET=whale-raw
WHALE_S3_REGION=us-east-1
WHALE_S3_ACCESS_KEY=minioadmin
WHALE_S3_SECRET_KEY=minioadmin
WHALE_S3_ADDRESSING_STYLE=path
