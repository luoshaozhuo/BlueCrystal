# =============================================================================
# Whale 现场部署环境变量模板
# =============================================================================
# 复制本文件为 .env.whale.field 并修改实际值：
#   cp .env.whale.field.example .env.whale.field
#
# 运行模式: dev / compose / prodlike / field
#   dev:     本地开发，SQLite + Redis memory + InMemory bus
#   compose: docker compose 单机，PostgreSQL + Redis + Kafka
#   prodlike: 生产模拟，全部真实依赖可用
#   field:   现场部署（当前为工程收口，部分组件 environment-pending）
# =============================================================================

# ---- 运行模式 ----
WHALE_RUN_MODE=prodlike

# ---- Station 标识 ----
WHALE_STATION_ID=whale-field-01

# =============================================================================
# Ingest 配置
# =============================================================================

# PostgreSQL runtime 数据库
WHALE_INGEST_DATABASE_BACKEND=postgresql
WHALE_INGEST_DATABASE_URL=postgresql+psycopg://whale:whale@localhost:5432/whale_ingest

# Redis state cache
WHALE_INGEST_STATE_CACHE_BACKEND=redis
WHALE_INGEST_REDIS_URL=redis://localhost:16379/0
WHALE_INGEST_REDIS_STATE_HASH_KEY=whale:ingest:state

# 心跳与租约
WHALE_INGEST_HEARTBEAT_INTERVAL_SECONDS=5
WHALE_INGEST_HEARTBEAT_TIMEOUT_SECONDS=15
WHALE_INGEST_LEASE_TTL_SECONDS=10
WHALE_INGEST_PULL_MAX_IN_FLIGHT=8

# 审计
WHALE_INGEST_AUDIT_JSONL_PATH=/audit/ingest-audit.jsonl

# 访问策略
WHALE_INGEST_ACCESS_POLICY_MODE=file-policy
WHALE_INGEST_ACCESS_POLICY_FILE=config/ingest/access_policy.prodlike.yaml

# =============================================================================
# Message Pipeline - Kafka
# =============================================================================

# Kafka 连接
WHALE_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
# SASL/SSL (可选，按环境启用)
# WHALE_KAFKA_SECURITY_PROTOCOL=SASL_SSL
# WHALE_KAFKA_SASL_MECHANISM=PLAIN
# WHALE_KAFKA_SASL_USERNAME=
# WHALE_KAFKA_SASL_PASSWORD=
# WHALE_KAFKA_SSL_CAFILE=
# WHALE_KAFKA_SSL_CERTFILE=
# WHALE_KAFKA_SSL_KEYFILE=

# topic 前缀
WHALE_KAFKA_TOPIC_PREFIX=whale

# consumer group 命名规范
WHALE_KAFKA_CONSUMER_GROUP_PREFIX=whale-speed-layer

# producer 配置
WHALE_KAFKA_ACKS=all
WHALE_KAFKA_RETRIES=3
WHALE_KAFKA_REQUEST_TIMEOUT_MS=5000

# consumer 配置
WHALE_KAFKA_AUTO_OFFSET_RESET=earliest
WHALE_KAFKA_ENABLE_AUTO_COMMIT=false

# =============================================================================
# Message Pipeline - Pulsar (environment-pending)
# =============================================================================

# Pulsar 服务地址（仅在 Pulsar 集群可用时启用）
# WHALE_PULSAR_SERVICE_URL=pulsar://localhost:6650
# WHALE_PULSAR_TOPIC_PREFIX=whale
# WHALE_PULSAR_SUBSCRIPTION_NAME=whale-speed-layer
# WHALE_PULSAR_SUBSCRIPTION_TYPE=Shared

# =============================================================================
# Storage - raw_archive
# =============================================================================

# 归档后端: local / hdfs / s3
WHALE_RAW_ARCHIVE_BACKEND=local
# 本地文件系统路径
WHALE_RAW_ARCHIVE_BASE_PATH=/data/whale/raw_archive
# 压缩算法: gzip / zstd
WHALE_RAW_ARCHIVE_COMPRESSION=gzip

# HDFS 配置（仅在 HDFS 集群可用时启用，environment-pending）
# WHALE_RAW_ARCHIVE_HDFS_NAMENODE_URL=http://namenode:9870
# WHALE_RAW_ARCHIVE_HDFS_BASE_PATH=/whale/raw_archive
# WHALE_RAW_ARCHIVE_HDFS_USER=whale

# S3/MinIO 配置（仅在 S3 服务可用时启用，environment-pending）
# WHALE_RAW_ARCHIVE_S3_ENDPOINT_URL=http://minio:9000
# WHALE_RAW_ARCHIVE_S3_BUCKET=whale-raw-archive
# WHALE_RAW_ARCHIVE_S3_ACCESS_KEY=
# WHALE_RAW_ARCHIVE_S3_SECRET_KEY=
# WHALE_RAW_ARCHIVE_S3_PREFIX=raw_archive/

# =============================================================================
# Storage - TDengine raw_index (environment-pending)
# =============================================================================

# TDengine 连接（仅在 TDengine 集群可用时启用）
# WHALE_TDENGINE_RAW_INDEX_HOST=localhost
# WHALE_TDENGINE_RAW_INDEX_PORT=6041
# WHALE_TDENGINE_RAW_INDEX_DB=whale_raw_index
# WHALE_TDENGINE_RAW_INDEX_USER=root
# WHALE_TDENGINE_RAW_INDEX_PASSWORD=taosdata
# WHALE_TDENGINE_RAW_INDEX_TTL_DAYS=90

# =============================================================================
# Storage - TDengine standardized (environment-pending)
# =============================================================================

# TDengine 连接（仅在 TDengine 集群可用时启用）
# WHALE_TDENGINE_STANDARDIZED_HOST=localhost
# WHALE_TDENGINE_STANDARDIZED_PORT=6041
# WHALE_TDENGINE_STANDARDIZED_DB=whale_standardized
# WHALE_TDENGINE_STANDARDIZED_USER=root
# WHALE_TDENGINE_STANDARDIZED_PASSWORD=taosdata
# WHALE_TDENGINE_STANDARDIZED_TTL_DAYS=365

# =============================================================================
# Speed Layer 配置
# =============================================================================

# writer 实例数
WHALE_SPEED_LAYER_WRITER_COUNT=1
# 归档批量大小
WHALE_SPEED_LAYER_BATCH_SIZE=100
# 最大并发 writer 数
WHALE_SPEED_LAYER_MAX_CONCURRENT_WRITERS=4

# =============================================================================
# Checkpoint 配置
# =============================================================================

# checkpoint 后端: file / redis / kafka
WHALE_CHECKPOINT_BACKEND=file
WHALE_CHECKPOINT_PATH=/data/whale/checkpoints

# Redis checkpoint（仅在启用 redis backend 时使用）
# WHALE_CHECKPOINT_REDIS_URL=redis://localhost:16379/1

# checkpoint 间隔（毫秒）
WHALE_CHECKPOINT_INTERVAL_MS=60000

# =============================================================================
# DLQ 配置
# =============================================================================

# DLQ topic（消息处理失败超过重试上限后写入）
WHALE_DLQ_TOPIC=whale.ingest.state.dlq

# DLQ 本地 sink 路径（fallback，当 DLQ topic 不可用时）
WHALE_DLQ_LOCAL_SINK_PATH=/data/whale/dlq

# =============================================================================
# Serving Cache 配置
# =============================================================================

# serving cache 后端: memory / redis
WHALE_SERVING_CACHE_BACKEND=memory
# TTL 秒数
WHALE_SERVING_CACHE_TTL=60

# Redis serving cache（仅在启用 redis backend 时使用，environment-pending）
# WHALE_SERVING_CACHE_REDIS_URL=redis://localhost:16379/2
